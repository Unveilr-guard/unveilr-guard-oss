{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guard.unveilr.ai/schemas/v1alpha1/policy.schema.json",
  "title": "Policy",
  "description": "Policy-as-code evaluated against an ActionIntent. Deliberately not a programming language: match is a set of equality or set-membership constraints, evaluated deterministically. Expressiveness is the enemy of validatability, and a decision that cannot be replayed cannot be evidence.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "guard.unveilr.ai/v1alpha1" },
    "kind": { "const": "Policy" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "match", "effect"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
              "description": { "type": "string" },
              "match": {
                "type": "object",
                "minProperties": 1,
                "description": "Dotted paths into the ActionIntent. A string matches exactly; an array matches set membership. All keys must match (AND). An empty match is rejected — a rule matching everything is almost always a mistake.",
                "additionalProperties": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                  ]
                },
                "examples": [
                  { "action.type": "shell.exec", "context.environment": "production" },
                  { "action.provider": "aws", "action.name": ["iam:PassRole", "iam:AttachRolePolicy"] }
                ]
              },
              "effect": {
                "description": "allow/deny/warn are evaluated locally. The rest are accepted for schema compatibility with the enterprise plane and reported as unsupported — never silently downgraded.",
                "enum": ["allow", "deny", "warn", "redact", "sanitize", "scoped_token", "require_approval", "step_up", "quarantine"]
              }
            }
          }
        }
      }
    }
  }
}
